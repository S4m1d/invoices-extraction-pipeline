# Pipeline stack (infra/README.md, Usage).
.PHONY: up up-fake down reset ps logs smoke check-env sources

# Without default build attestations an unchanged service builds to the same image ID, so a
# repeated `up` does not recreate its container.
export BUILDX_NO_DEFAULT_ATTESTATIONS := 1
COMPOSE := docker compose --env-file .env
# The data-source mounts, generated by `sources` (tester/backend/specs/data-sources.md, Docker setup).
# Recursive (=): expanded when a recipe runs, so `up` sees the file its prerequisite just wrote.
SOURCES = $(if $(wildcard docker-compose.sources.yml),-f docker-compose.sources.yml)
BASE = -f docker-compose.yml $(SOURCES)
FAKE = $(BASE) -f docker-compose.fake-llm.yml

check-env:
	@test -f .env || { echo "infra/.env is missing: copy .env.example to .env and set the passwords"; exit 1; }

# Builds the tester image, which validates tester-sources.yaml and prints the Compose override.
# Sources whose path is not a directory on this host are not mounted (the tester lists them as unavailable).
sources: check-env
	@test -f tester-sources.yaml || { echo "infra/tester-sources.yaml is missing: copy tester-sources.example.yaml and set the paths"; exit 1; }
	$(COMPOSE) -f docker-compose.yml build tester
	@docker run --rm -i invoices/tester sources-override --paths < tester-sources.yaml > .sources-paths.tmp \
	  || { rm -f .sources-paths.tmp; exit 1; }; \
	skip=$$(while IFS="$$(printf '\t')" read -r name path; do \
	    [ -d "$$path" ] || { echo "warning: data source $$name: $$path is not a directory; not mounted" >&2; printf '%s,' "$$name"; }; \
	  done < .sources-paths.tmp); \
	rm -f .sources-paths.tmp; \
	docker run --rm -i invoices/tester sources-override --skip "$$skip" < tester-sources.yaml > docker-compose.sources.yml.tmp \
	  && mv docker-compose.sources.yml.tmp docker-compose.sources.yml \
	  || { rm -f docker-compose.sources.yml.tmp; exit 1; }

up: check-env sources
	@test -f ../fields-extractor/.env || { echo "fields-extractor/.env is missing (ANTHROPIC_API_KEY); or use make up-fake"; exit 1; }
	$(COMPOSE) $(BASE) up -d --build --wait --remove-orphans

up-fake: check-env sources
	$(COMPOSE) $(FAKE) up -d --build --wait --remove-orphans

down: check-env
	$(COMPOSE) $(FAKE) down --remove-orphans

reset: check-env
	$(COMPOSE) $(FAKE) down --remove-orphans --volumes

ps: check-env
	$(COMPOSE) $(FAKE) ps -a

logs: check-env
	$(COMPOSE) $(FAKE) logs --tail 100 $(s)

smoke: check-env
	python3 smoke.py
