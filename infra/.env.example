# Copy to .env (gitignored) and set the passwords (infra/README.md, Configuration and secrets).
# The Anthropic API key is not here: it is read from fields-extractor/.env.

RABBITMQ_USER=pipeline
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=pipeline
MINIO_ROOT_PASSWORD=
POSTGRES_PASSWORD=
INTEGRATOR_DB_PASSWORD=
TESTER_DB_PASSWORD=

